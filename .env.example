PORT=3000
NODE_ENV=production
# Set DATABASE_URL using your runtime secrets store, not a checked-in file.
# DATABASE_URL=postgres://marketreader:local-password@localhost:5432/marketreader
# DB_SSL=require
# Local docker compose expects POSTGRES_PASSWORD to be set externally.

# Optional model research (API secret stays server-side)
# AI_API_KEY=
# AI_MODEL=
# SEC_USER_AGENT=MarketreaderPro research admin@example.org

# Optional Plaid Link backend. Configure only using private secret manager.
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox
# BANK_TOKEN_KEY=64_lowercase_hex_characters_generated_using_a_secure_random_generator

# Keep disabled for a public research deployment.
ENABLE_EXPERIMENTAL_FEATURES=false

# Optional SEC CIKs to include in Morning Intelligence (max 10)
# MRP_SEC_CIKS=0000320193,0000789019

# Optional dedicated persistent-host morning scheduler (America/Chicago)
MRP_BRIEFING_HOUR=7
MRP_BRIEFING_MINUTE=0

# Optional operator-paid AI explanation of public morning headlines
AI_BRIEFING_ENABLED=false

# Government disclosure import: for lawful reviewed House bulk index only
HOUSE_DISCLOSURE_USE_AUTHORIZED=false
